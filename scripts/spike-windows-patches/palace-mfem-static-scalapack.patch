--- a/cmake/ExternalMFEM.cmake
+++ b/cmake/ExternalMFEM.cmake
@@ -304,10 +304,21 @@
     endif()
   endif()
 
+  # A static ScaLAPACK carries no record of what it needs, so its MPI and
+  # BLAS/LAPACK references must follow it on the link line; MFEM puts the
+  # REQUIRED_LIBRARIES after the REQUIRED_PACKAGES, and a shared build never
+  # noticed.
+  set(SCALAPACK_LINK_LIBRARIES ${SCALAPACK_LIBRARIES})
+  if(NOT BUILD_SHARED_LIBS)
+    list(APPEND SCALAPACK_LINK_LIBRARIES
+      ${BLAS_LAPACK_LIBRARIES} ${MPI_Fortran_LIBRARIES} ${MPI_C_LIBRARIES}
+    )
+  endif()
+
   # Configure STRUMPACK
   if(PALACE_WITH_STRUMPACK)
     set(STRUMPACK_REQUIRED_PACKAGES "ParMETIS" "METIS" "LAPACK" "BLAS" "MPI" "MPI_Fortran")
-    set(STRUMPACK_REQUIRED_LIBRARIES ${SCALAPACK_LIBRARIES} ${STRUMPACK_MUMPS_GFORTRAN_LIBRARY})
+    set(STRUMPACK_REQUIRED_LIBRARIES ${SCALAPACK_LINK_LIBRARIES} ${STRUMPACK_MUMPS_GFORTRAN_LIBRARY})
     if(NOT "${STRUMPACK_EXTRA_LIBRARIES}" STREQUAL "")
       list(PREPEND STRUMPACK_REQUIRED_LIBRARIES ${STRUMPACK_EXTRA_LIBRARIES})
     endif()
@@ -332,6 +343,7 @@
   endif()
 
   # Configure MUMPS
+  string(REPLACE ";" "$<SEMICOLON>" SCALAPACK_LINK_LIBRARIES_ESCAPED "${SCALAPACK_LINK_LIBRARIES}")
   if(PALACE_WITH_MUMPS)
     set(MUMPS_REQUIRED_PACKAGES "ParMETIS" "METIS" "LAPACK" "BLAS" "MPI" "MPI_Fortran" "Threads")
     if(PALACE_WITH_OPENMP)
@@ -341,7 +353,7 @@
     list(APPEND MFEM_OPTIONS
       "-DMUMPS_DIR=${CMAKE_INSTALL_PREFIX}"
       "-DMUMPS_REQUIRED_PACKAGES=${MUMPS_REQUIRED_PACKAGES}"
-      "-DMUMPS_REQUIRED_LIBRARIES=${SCALAPACK_LIBRARIES}$<SEMICOLON>${STRUMPACK_MUMPS_GFORTRAN_LIBRARY}"
+      "-DMUMPS_REQUIRED_LIBRARIES=${SCALAPACK_LINK_LIBRARIES_ESCAPED}$<SEMICOLON>${STRUMPACK_MUMPS_GFORTRAN_LIBRARY}"
     )
   endif()
 

diff --git a/cmake/mumps_mingw_mpi.cmake b/cmake/mumps_mingw_mpi.cmake
new file mode 100644
index 0000000..fb75efd
--- /dev/null
+++ b/cmake/mumps_mingw_mpi.cmake
@@ -0,0 +1,25 @@
+# Backport of scivision/mumps 09a718d177 (2026-10-01): gfortran cannot compile
+# MUMPS's *ana_aux_par.F against MS-MPI's mpif.h, whose !GCC$ DLLIMPORT
+# attributes clash with module-level declarations; the patch switches those
+# four files to "USE MPI". Based on MSYS2's mingw-w64-mumps 0004-mpi-module.patch.
+# Adapted to this pin: the fetched source is <lowercase project>_SOURCE_DIR.
+
+find_package(Git REQUIRED)
+set(_patch "${CMAKE_CURRENT_SOURCE_DIR}/cmake/mumps_mingw_mpi.patch")
+string(TOLOWER "${PROJECT_NAME}" _mumps_name)
+set(_mumps_source "${${_mumps_name}_SOURCE_DIR}")
+
+execute_process(
+  COMMAND "${GIT_EXECUTABLE}" apply --ignore-whitespace --reverse --check -p1 "${_patch}"
+  WORKING_DIRECTORY "${_mumps_source}"
+  RESULT_VARIABLE _already_applied
+  OUTPUT_QUIET ERROR_QUIET
+)
+if(NOT _already_applied EQUAL 0)
+  execute_process(
+    COMMAND "${GIT_EXECUTABLE}" apply --ignore-whitespace -p1 "${_patch}"
+    WORKING_DIRECTORY "${_mumps_source}"
+    COMMAND_ECHO STDOUT
+    COMMAND_ERROR_IS_FATAL ANY
+  )
+endif()

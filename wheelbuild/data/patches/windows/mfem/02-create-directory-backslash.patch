Carried patch, Windows only: MFEM creates directories split on either separator.

DataCollection::create_directory creates a collection's parent directories by
splitting the path on '/' only. Palace builds the ParaView collection path with
std::filesystem, so on Windows it reaches MFEM as
"postpro\paraview\electrostatic/Cycle000001": no parent is created, mkdir fails
with ENOENT, every save warns "Error creating directory" and no ParaView output
is written at all (0.18.1.post3). Under _WIN32 this splits on '\' as well. No
effect on Linux and macOS. Still present on MFEM master.

--- a/fem/datacollection.cpp
+++ b/fem/datacollection.cpp
@@ -36,7 +36,13 @@
                                      const Mesh *mesh, int myid)
 {
    // create directories recursively
-   const char path_delim = '/';
+#ifdef _WIN32
+   // Either separator, as Windows accepts both: Palace builds collection paths
+   // with std::filesystem, whose native separator here is '\'.
+   const char *path_delims = "/\\";
+#else
+   const char *path_delims = "/";
+#endif
    std::string::size_type pos = 0;
    int err_flag;
 #ifdef MFEM_USE_MPI
@@ -45,7 +51,7 @@
 
    do
    {
-      pos = dir_name.find(path_delim, pos+1);
+      pos = dir_name.find_first_of(path_delims, pos+1);
       std::string subdir = dir_name.substr(0, pos);
 
 #ifndef MFEM_USE_MPI

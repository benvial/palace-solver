+++ b/src/generator_gemm_mma_microkernel.c
@@ -456,3 +456,3 @@ void libxsmm_generator_mma_alu( libxsmm_generated_code *io_generated_code,
   } else {
-    unsigned long l_op;
+    unsigned long long l_op;
     switch ( i_datatype ) {

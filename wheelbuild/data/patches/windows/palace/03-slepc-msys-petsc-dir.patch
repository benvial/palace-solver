Carried patch, Windows only: hand SLEPc a PETSC_DIR its python can read.

SLEPc's build runs the POSIX (MSYS2) python that PETSc's configure recorded,
which reads D:/... as a relative path. Under MINGW, cmake/ExternalSLEPc.cmake
passes PETSC_DIR to SLEPc's configure, build and install in its /D/... form.

diff --git a/cmake/ExternalSLEPc.cmake b/cmake/ExternalSLEPc.cmake
index 4a6d060..d02c739 100644
--- a/cmake/ExternalSLEPc.cmake
+++ b/cmake/ExternalSLEPc.cmake
@@ -131,6 +131,14 @@ set(SLEPC_OPTIONS
 string(REPLACE ";" "; " SLEPC_OPTIONS_PRINT "${SLEPC_OPTIONS}")
 message(STATUS "SLEPC_OPTIONS: ${SLEPC_OPTIONS_PRINT}")
 
+# SLEPc's build runs the POSIX (MSYS2) python that PETSc's configure
+# recorded, which reads D:/... as a relative path; under MinGW hand it the
+# /D/... form the MSYS2 tools understand.
+set(SLEPC_PETSC_DIR ${CMAKE_INSTALL_PREFIX})
+if(MINGW)
+  string(REGEX REPLACE "^([A-Za-z]):/" "/\\1/" SLEPC_PETSC_DIR "${SLEPC_PETSC_DIR}")
+endif()
+
 include(ExternalProject)
 ExternalProject_Add(slepc
   DEPENDS             ${SLEPC_DEPENDENCIES}
@@ -141,10 +149,10 @@ ExternalProject_Add(slepc
   PREFIX              ${CMAKE_BINARY_DIR}/extern/slepc-cmake
   BUILD_IN_SOURCE     TRUE
   UPDATE_COMMAND      ""
-  CONFIGURE_COMMAND   SLEPC_DIR=<SOURCE_DIR> PETSC_DIR=${CMAKE_INSTALL_PREFIX} PETSC_ARCH= ./configure ${SLEPC_OPTIONS}
-  BUILD_COMMAND       SLEPC_DIR=<SOURCE_DIR> PETSC_DIR=${CMAKE_INSTALL_PREFIX} PETSC_ARCH= ${CMAKE_MAKE_PROGRAM}
-  INSTALL_COMMAND     SLEPC_DIR=<SOURCE_DIR> PETSC_DIR=${CMAKE_INSTALL_PREFIX} PETSC_ARCH= ${CMAKE_MAKE_PROGRAM} install
-  # TEST_COMMAND        SLEPC_DIR=<SOURCE_DIR> PETSC_DIR=${CMAKE_INSTALL_PREFIX} PETSC_ARCH= ${CMAKE_MAKE_PROGRAM} check
+  CONFIGURE_COMMAND   SLEPC_DIR=<SOURCE_DIR> PETSC_DIR=${SLEPC_PETSC_DIR} PETSC_ARCH= ./configure ${SLEPC_OPTIONS}
+  BUILD_COMMAND       SLEPC_DIR=<SOURCE_DIR> PETSC_DIR=${SLEPC_PETSC_DIR} PETSC_ARCH= ${CMAKE_MAKE_PROGRAM}
+  INSTALL_COMMAND     SLEPC_DIR=<SOURCE_DIR> PETSC_DIR=${SLEPC_PETSC_DIR} PETSC_ARCH= ${CMAKE_MAKE_PROGRAM} install
+  # TEST_COMMAND        SLEPC_DIR=<SOURCE_DIR> PETSC_DIR=${SLEPC_PETSC_DIR} PETSC_ARCH= ${CMAKE_MAKE_PROGRAM} check
   TEST_COMMAND        ""
   TEST_BEFORE_INSTALL TRUE
 )

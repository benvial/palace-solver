diff --git a/palace/utils/tablecsv.hpp b/palace/utils/tablecsv.hpp
index e6364a6..b79919e 100644
--- a/palace/utils/tablecsv.hpp
+++ b/palace/utils/tablecsv.hpp
@@ -5,9 +5,11 @@
 #define PALACE_UTILS_TABLECSV_HPP
 
 #include <cstddef>
+#include <filesystem>
 #include <optional>
 #include <string>
 #include <string_view>
+#include <type_traits>
 #include <unordered_map>
 #include <vector>
 
@@ -157,6 +159,15 @@ public:
 
   TableWithCSVFile() = default;
   explicit TableWithCSVFile(std::string csv_file_fullpath, bool load_existing_file = false);
+  // std::filesystem::path converts to std::string implicitly only where its value_type is
+  // char; on Windows it is wchar_t. Constrained to path itself so that string literals
+  // still pick the std::string constructor unambiguously.
+  template <typename P,
+            typename = std::enable_if_t<std::is_same_v<std::decay_t<P>, std::filesystem::path>>>
+  explicit TableWithCSVFile(const P &csv_file_fullpath, bool load_existing_file = false)
+    : TableWithCSVFile(csv_file_fullpath.string(), load_existing_file)
+  {
+  }
 
   std::string_view get_csv_filepath() const { return {csv_file_fullpath_}; }
 

Carried patch, Windows only: libCEED as a MinGW DLL.

interface/ceed.c calls posix_memalign, which Windows lacks; on _WIN32 it
uses malloc (not _aligned_malloc, whose memory realloc() and free() cannot
take). Its cache directory, which only the GPU backends' JiT reads, uses
<wordexp.h> and a two-argument mkdir; on _WIN32 the path is taken as written
and mkdir is _mkdir. The Makefile's sed s:%prefix%:...: breaks on the colon in
D:/; it uses | instead. On Windows the library is libceed.dll with a
libceed.dll.a import library, because MinGW ld does not search *.so, XSMM_DIR
loses its abspath, which MSYS2 make reads as relative, and LIBXSMM is found by
directory rather than by the pkg-config file. Linux and macOS build as before.

diff --git a/Makefile b/Makefile
index ce01a80..8b092a4 100644
--- a/Makefile
+++ b/Makefile
@@ -35,6 +35,8 @@ XDG_CACHE_HOME      ?= $(HOME)/.cache
 CEED_CACHE_BASE_DIR ?= $(XDG_CACHE_HOME)
 
 DARWIN := $(filter Darwin,$(shell uname -s))
+# Windows (MinGW): a DLL with an import library, which is what ld searches.
+WINDOWS := $(filter Windows_NT,$(OS))
 
 
 # ------------------------------------------------------------
@@ -260,7 +262,7 @@ MFLAGS := -j $(NPROCS) --warn-undefined-variables \
 PYTHON ?= python3
 PROVE ?= prove
 PROVE_OPTS ?= -j $(NPROCS)
-SO_EXT := $(if $(DARWIN),dylib,so)
+SO_EXT := $(if $(DARWIN),dylib,$(if $(WINDOWS),dll,so))
 
 ceed.pc := $(LIBDIR)/pkgconfig/ceed.pc
 libceed.so := $(LIBDIR)/libceed.$(SO_EXT)
@@ -311,6 +313,8 @@ lib: $(libceed) $(ceed.pc)
 par:;@$(MAKE) $(MFLAGS) V=$(V) lib
 
 $(libceed.so) : CEED_LDFLAGS += $(if $(DARWIN), -install_name @rpath/$(notdir $(libceed.so)))
+CEED_IMPLIB_FLAG := -Wl,--out-implib,$(LIBDIR)/libceed.dll.a
+$(libceed.so) : CEED_LDFLAGS += $(if $(WINDOWS),$(CEED_IMPLIB_FLAG))
 
 # ------------------------------------------------------------
 # Source files
@@ -643,13 +647,14 @@ XSMM_BACKENDS = /cpu/self/xsmm/serial /cpu/self/xsmm/blocked
 ifneq ($(wildcard $(XSMM_DIR)/lib/libxsmm.*),)
   # Prefer the pkg-config file, which has the installed include directory (include/libxsmm
   # for LIBXSMM 2.x) and the libraries LIBXSMM needs
-  ifneq ($(wildcard $(XSMM_DIR)/lib/pkgconfig/libxsmm.pc),)
+  # Not on Windows, where $(abspath) misreads D:/ and pkg-config is not on the build's path.
+  ifneq ($(if $(WINDOWS),,$(wildcard $(XSMM_DIR)/lib/pkgconfig/libxsmm.pc)),)
     XSMM_PC = $(abspath $(XSMM_DIR))/lib/pkgconfig/libxsmm.pc
     XSMM_CFLAGS ?= $(call pkgconf, --cflags $(XSMM_PC))
     XSMM_LIBS ?= $(call pkgconf, --libs $(XSMM_PC))
   else
     XSMM_CFLAGS ?= -I$(XSMM_DIR)/include -I$(XSMM_DIR)/include/libxsmm
-    XSMM_LIBS ?= -L$(abspath $(XSMM_DIR))/lib -lxsmm
+    XSMM_LIBS ?= -L$(if $(WINDOWS),$(XSMM_DIR),$(abspath $(XSMM_DIR)))/lib -lxsmm
   endif
   # LIBXSMM 2.0 has no BLAS fallback (libxsmm/libxsmm#981); builds of earlier main snapshots
   # with BLAS enabled can pass the BLAS library here
@@ -1014,9 +1019,9 @@ $(OBJDIR)/ceed.pc : pkgconfig-prefix = $(prefix)
 .INTERMEDIATE : $(OBJDIR)/ceed.pc
 %/ceed.pc : ceed.pc.template | $$(@D)/.DIR
 	@$(SED) \
-	    -e "s:%prefix%:$(pkgconfig-prefix):" \
-	    -e "s:%opt%:$(OPT):" \
-	    -e "s:%libs_private%:$(pkgconfig-libs-private.clean):" $< > $@
+	    -e "s|%prefix%|$(pkgconfig-prefix)|" \
+	    -e "s|%opt%|$(OPT)|" \
+	    -e "s|%libs_private%|$(pkgconfig-libs-private.clean)|" $< > $@
 
 GIT_DESCRIBE = $(shell git -c safe.directory=$PWD describe --always --dirty 2>/dev/null || printf "unknown\n")
 
@@ -1052,6 +1057,7 @@ install : lib $(OBJDIR)/ceed.pc
 	$(INSTALL_DATA) include/ceed/cuda.h "$(DESTDIR)$(includedir)/ceed/"
 	$(INSTALL_DATA) include/ceed/hip.h "$(DESTDIR)$(includedir)/ceed/"
 	$(INSTALL_DATA) $(libceed) "$(DESTDIR)$(libdir)/"
+	$(if $(and $(WINDOWS),$(filter $(libceed.so),$(libceed))),$(INSTALL_DATA) $(LIBDIR)/libceed.dll.a "$(DESTDIR)$(libdir)/")
 	$(INSTALL_DATA) $(OBJDIR)/ceed.pc "$(DESTDIR)$(pkgconfigdir)/"
 	$(INSTALL_DATA) include/ceed.h "$(DESTDIR)$(includedir)/"
 	$(INSTALL_DATA) include/ceedf.h "$(DESTDIR)$(includedir)/"
diff --git a/interface/ceed.c b/interface/ceed.c
index 7443b69..186f582 100644
--- a/interface/ceed.c
+++ b/interface/ceed.c
@@ -19,7 +19,13 @@
 #include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
+#if defined(_WIN32)
+#include <direct.h>
+// MinGW's mkdir takes no mode, and the cache directory inherits its parent's ACL.
+#define mkdir(path, mode) _mkdir(path)
+#else
 #include <wordexp.h>
+#endif
 #include <sys/stat.h>
 
 /// @cond DOXYGEN_SKIP
@@ -321,8 +327,15 @@ void CeedDebugImpl256(const unsigned char color, const char *format, ...) {
   @sa CeedFree()
 **/
 int CeedMallocArray(size_t n, size_t unit, void *p) {
+#if defined(_WIN32)
+  // Windows has no posix_memalign, and _aligned_malloc memory cannot be passed to the realloc() and free() that
+  // CeedReallocArray and CeedFree use. CeedCalloc already returns calloc alignment, so nothing may rely on CEED_ALIGN.
+  *(void **)p = malloc(n * unit);
+  CeedCheck(!n || !unit || *(void **)p, NULL, CEED_ERROR_MAJOR, "malloc failed to allocate %zd members of size %zd\n", n, unit);
+#else
   int ierr = posix_memalign((void **)p, CEED_ALIGN, n * unit);
   CeedCheck(ierr == 0, NULL, CEED_ERROR_MAJOR, "posix_memalign failed to allocate %zd members of size %zd\n", n, unit);
+#endif
   return CEED_ERROR_SUCCESS;
 }
 
@@ -1171,12 +1184,26 @@ static int CeedMkdirParents(Ceed ceed, char *path) {
 int CeedGetCacheDir(Ceed ceed, const char **cache_dir) {
   const char *ceed_cache_base_dir;
   const char  suffix[] = "libCEED";
-  wordexp_t   word_expansion;
-  char       *final_cache_dir;
+#if !defined(_WIN32)
+  wordexp_t word_expansion;
+#endif
+  char *final_cache_dir;
 
   CeedCall(CeedGetCacheBaseDir(ceed, &ceed_cache_base_dir));
   CeedCheck(ceed_cache_base_dir != NULL, ceed, CEED_ERROR_INCOMPATIBLE, "Cache base directory must not be NULL");
 
+#if defined(_WIN32)
+  // No wordexp on Windows: the base directory is taken as written, which only loses shell
+  // expansion of a path nothing but the GPU backends' JiT reads.
+  {
+    const size_t base_length          = strlen(ceed_cache_base_dir);
+    const bool   needs_trailing_slash = ceed_cache_base_dir[base_length - 1] != '/';
+    const size_t length               = base_length + sizeof(suffix) + (needs_trailing_slash ? 1 : 0);
+
+    CeedCall(CeedCalloc(length, &final_cache_dir));
+    snprintf(final_cache_dir, length, "%s%s%s", ceed_cache_base_dir, needs_trailing_slash ? "/" : "", suffix);
+  }
+#else
   {
     char        *wrapped_str;
     const size_t base_length          = strlen(ceed_cache_base_dir);
@@ -1198,6 +1225,7 @@ int CeedGetCacheDir(Ceed ceed, const char **cache_dir) {
     CeedCall(CeedFree(&wrapped_str));
   }
   CeedCall(CeedStringAllocCopy(word_expansion.we_wordv[0], &final_cache_dir));
+#endif
   // Create cache dir if needed
   {
     DIR *dir = opendir(final_cache_dir);
@@ -1210,7 +1238,9 @@ int CeedGetCacheDir(Ceed ceed, const char **cache_dir) {
       CeedCall(CeedMkdirParents(ceed, final_cache_dir));
     }
   }
+#if !defined(_WIN32)
   wordfree(&word_expansion);
+#endif
   *cache_dir = final_cache_dir;
   return CEED_ERROR_SUCCESS;
 }
